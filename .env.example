# URL del bot-confirmador (en local: http://localhost:3001/pedido)
BOT_CONFIRMADOR_URL=http://localhost:3001/pedido

# Secreto compartido para autenticar requests entre la landing y el bot-confirmador
BOT_CONFIRMADOR_SECRET=cambia-este-secreto

# Tracking (cuando estén disponibles)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ============================================================================
# ANTI-FRAUDE del checkout (ver README → "Anti-fraude"). Todos con defaults
# sensatos: si dejas algo vacío, se usa el default. Sube/baja para endurecer.
# ============================================================================

# --- Rate limiter: preferido Upstash Redis (free tier, edge). Si falta, cae a
#     Supabase (tabla af RPC). Si faltan AMBOS → fail-SAFE (pasa + sospechoso).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback Supabase (ya usado por el repo): requiere el RPC af_rate_hit (SQL en README)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Umbrales del rate limiter (defaults) ---
RL_IP_CONFIRMED_24H=1       # pedidos CONFIRMADOS por IP / 24h
RL_PHONE_CONFIRMED_24H=1    # pedidos CONFIRMADOS por teléfono / 24h
RL_IP_SUBMISSIONS_1H=5      # submissions de CUALQUIER tipo por IP / 1h (tapa flood de preliminares)
RL_IP_BURST_10MIN=10        # ráfaga dura por IP / 10 min → 429

# --- Anti-bot suave ---
ANTIFRAUD_MIN_SUBMIT_MS=3000  # < esto entre carga y submit = time-to-submit sospechoso
BOT_SCORE_UMBRAL=3            # score de señales ≥ esto → sospechoso=true (no bloquea)

# --- Turnstile invisible (OPCIONAL, OFF por defecto — nunca en el camino feliz) ---
TURNSTILE_ENABLED=false          # true = pedir challenge SOLO si score alto
TURNSTILE_SCORE_UMBRAL=6         # score ≥ esto (y enabled) → exige token
TURNSTILE_SECRET_KEY=            # secret de Cloudflare Turnstile (si se activa)
